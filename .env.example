# ===========================================
# Disipl — Environment Variables
# ===========================================
# Bu faylning nusxasini .env ga aylantiring:
#   cp .env.example .env
# Keyin qiymatlarni o'zgartiring.
# ===========================================

# --- PostgreSQL ---
POSTGRES_USER=disipl
POSTGRES_PASSWORD=changeme
POSTGRES_DB=discipline_db
DATABASE_URL=postgresql+asyncpg://disipl:changeme@localhost:5432/discipline_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- JWT Auth ---
JWT_SECRET_KEY=changeme-generate-a-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# --- LLM Provider ---
# "claude" yoki "ollama"
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
