# ===========================================
# Disipl — Environment Variables
# ===========================================
# Bu faylning nusxasini .env ga aylantiring:
#   cp .env.example .env
# Keyin qiymatlarni o'zgartiring.
# ===========================================

# --- PostgreSQL ---
POSTGRES_USER=disipl
POSTGRES_PASSWORD=changeme
POSTGRES_DB=discipline_db
DATABASE_URL=postgresql+asyncpg://disipl:changeme@localhost:5432/discipline_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- JWT Auth ---
JWT_SECRET_KEY=changeme-generate-a-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# --- LLM Provider ---
# "claude" yoki "ollama"
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# --- Payment — Payme ---
PAYME_MERCHANT_ID=your_merchant_id
PAYME_SECRET_KEY=your_secret_key

# --- Payment — Click ---
CLICK_MERCHANT_ID=your_merchant_id
CLICK_SECRET_KEY=your_secret_key

# --- Payment Default Provider ---
# "payme" yoki "click"
PAYMENT_PROVIDER=payme

# --- Encryption ---
# Maxfiy ma'lumotlarni shifrlash uchun kalit.
# Production'da kuchli random kalit ishlating!
# Generatsiya: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=your-encryption-key-here

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
